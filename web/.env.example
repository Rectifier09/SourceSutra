# Copy to web/.env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.
# Both values are PUBLIC (the anon key is designed to be exposed to the browser; RLS is what protects data).
#
# Local stack (supabase start prints these):
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase status`>
#
# Cloud (Supabase dashboard → Project → Settings → API):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-project-anon-key>
